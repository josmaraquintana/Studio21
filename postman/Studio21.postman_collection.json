{
  "info":{"_postman_id":"5e53ff9e-a7cd-46ac-ba3b-0154329b2747","name":"Studio21 API","description":"API REST del storefront de Studio 21 (Avance 4.1). Corre la colección completa en orden con el environment \"Studio21 Local\". El Login guarda el token y las carpetas protegidas lo usan solas.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token}}","type":"string"}]},
  "item":[
    {"name":"1. Auth","description":"Pantallas: Registro y Login. No llevan token.","item":[
      {"name":"Registro","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/auth/registro","host":["{{baseUrl}}"],"path":["api","auth","registro"]},"description":"Pantalla Registro. Crea un cliente nuevo con un correo distinto en cada corrida.","body":{"mode":"raw","raw":"{\n  \"nombre\": \"Cliente QA\",\n  \"telefono\": \"612-000-0000\",\n  \"correo\": \"{{correoPrueba}}\",\n  \"contrasenia\": \"{{passwordPrueba}}\"\n}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}},"event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["pm.environment.set(\"correoPrueba\", \"qa_\" + Date.now() + \"@example.com\");"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 201/200\", () => pm.expect(pm.response.code).to.be.oneOf([201, 200]));","const j = pm.response.json();","if (j.token) pm.environment.set(\"token\", j.token);"]}}]},
      {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/auth/login","host":["{{baseUrl}}"],"path":["api","auth","login"]},"description":"Pantalla Login. Guarda el token en el environment para el resto de la colección.","body":{"mode":"raw","raw":"{\n  \"correo\": \"{{correoPrueba}}\",\n  \"contrasenia\": \"{{passwordPrueba}}\"\n}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));","const j = pm.response.json();","pm.test(\"Regresa token\", () => pm.expect(j.token).to.be.a(\"string\"));","pm.environment.set(\"token\", j.token);"]}}]},
      {"name":"Error: login con contraseña incorrecta","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/auth/login","host":["{{baseUrl}}"],"path":["api","auth","login"]},"description":"","body":{"mode":"raw","raw":"{\n  \"correo\": \"{{correoPrueba}}\",\n  \"contrasenia\": \"incorrecta\"\n}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 401\", () => pm.response.to.have.status(401));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: registro con datos inválidos","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/auth/registro","host":["{{baseUrl}}"],"path":["api","auth","registro"]},"description":"","body":{"mode":"raw","raw":"{\n  \"nombre\": \"\",\n  \"telefono\": \"\",\n  \"correo\": \"no-es-correo\",\n  \"contrasenia\": \"1\"\n}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 400\", () => pm.response.to.have.status(400));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: registro con correo repetido","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/auth/registro","host":["{{baseUrl}}"],"path":["api","auth","registro"]},"description":"","body":{"mode":"raw","raw":"{\n  \"nombre\": \"Cliente QA\",\n  \"telefono\": \"612-000-0000\",\n  \"correo\": \"{{correoPrueba}}\",\n  \"contrasenia\": \"{{passwordPrueba}}\"\n}","options":{"raw":{"language":"json"}}},"auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 409\", () => pm.response.to.have.status(409));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]}
    ]},
    {"name":"2. Cuenta","description":"Pantalla Mi cuenta. Requiere token.","item":[
      {"name":"Ver mi cuenta","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/cuenta","host":["{{baseUrl}}"],"path":["api","cuenta"]},"description":""},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));","pm.test(\"No expone la contraseña\", () => pm.expect(pm.response.text()).to.not.include(\"contrasenia\"));"]}}]},
      {"name":"Actualizar mi cuenta","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/cuenta","host":["{{baseUrl}}"],"path":["api","cuenta"]},"description":"","body":{"mode":"raw","raw":"{\n  \"nombre\": \"Cliente QA Editado\",\n  \"telefono\": \"612-111-1111\",\n  \"correo\": \"{{correoPrueba}}\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
      {"name":"Error: ver cuenta sin token","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/cuenta","host":["{{baseUrl}}"],"path":["api","cuenta"]},"description":"","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 401\", () => pm.response.to.have.status(401));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: actualizar cuenta con datos inválidos","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/cuenta","host":["{{baseUrl}}"],"path":["api","cuenta"]},"description":"","body":{"mode":"raw","raw":"{\n  \"nombre\": \"\",\n  \"telefono\": \"\",\n  \"correo\": \"no-es-correo\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 400\", () => pm.response.to.have.status(400));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]}
    ]},
    {"name":"3. Catálogo","description":"Pantallas Catálogo y Producto. Públicos, sin token.","item":[
      {"name":"Listar productos","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/productos","host":["{{baseUrl}}"],"path":["api","productos"]},"description":"Pantalla Catálogo. Guarda en productoId la primera pieza DISPONIBLE (la lista trae también vendidas).","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));","const j = pm.response.json();","const lista = Array.isArray(j) ? j : (j.content || []);","pm.test(\"Solo productos visibles en tienda\", () => pm.expect(lista).to.be.an(\"array\"));","const disponible = lista.find(p => p.disponibilidad === \"DISPONIBLE\");","pm.test(\"Hay una pieza disponible para comprar\", () => pm.expect(disponible).to.exist);","if (disponible) pm.environment.set(\"productoId\", disponible.id);"]}}]},
      {"name":"Listar productos con filtros","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/productos?texto=playera&categoriaId=1&disponibilidad=DISPONIBLE&precioMax=50","host":["{{baseUrl}}"],"path":["api","productos"],"query":[{"key":"texto","value":"playera","disabled":false},{"key":"categoriaId","value":"1","disabled":false},{"key":"artistaId","value":"","disabled":true},{"key":"condicion","value":"COMO_NUEVA","disabled":true},{"key":"disponibilidad","value":"DISPONIBLE","disabled":false},{"key":"precioMax","value":"50","disabled":false},{"key":"orden","value":"precio_asc","disabled":true}]},"description":"Pantalla Catálogo con filtros. Activa o desactiva los parámetros según lo que pruebes.","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
      {"name":"Detalle de producto","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/productos/{{productoId}}","host":["{{baseUrl}}"],"path":["api","productos","{{productoId}}"]},"description":"Pantalla Producto.","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
      {"name":"Listar categorías","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/categorias","host":["{{baseUrl}}"],"path":["api","categorias"]},"description":"Filtro de categorías en Catálogo.","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
      {"name":"Listar artistas","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/artistas","host":["{{baseUrl}}"],"path":["api","artistas"]},"description":"Filtro de artistas en Catálogo.","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
      {"name":"Error: producto que no existe","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/productos/999999","host":["{{baseUrl}}"],"path":["api","productos","999999"]},"description":"","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 404\", () => pm.response.to.have.status(404));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: producto no verificado (id 3 del mock)","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/productos/3","host":["{{baseUrl}}"],"path":["api","productos","3"]},"description":"El producto 3 de datos-mock.sql está PENDIENTE y no activo: no debe verse en la tienda.","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 404\", () => pm.response.to.have.status(404));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]}
    ]},
    {"name":"4. Direcciones","description":"Pantallas Mis direcciones y Checkout (paso 1). Requiere token.","item":[
      {"name":"Crear dirección","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/direcciones","host":["{{baseUrl}}"],"path":["api","direcciones"]},"description":"Mis direcciones, botón Guardar dirección. Guarda el id en direccionId.","body":{"mode":"raw","raw":"{\n  \"destinatario\": \"Cliente QA\",\n  \"telefono\": \"612-000-0000\",\n  \"calle\": \"Calle de Prueba\",\n  \"numeroExterior\": \"123\",\n  \"colonia\": \"Colonia Ficticia\",\n  \"ciudad\": \"La Paz\",\n  \"estado\": \"Baja California Sur\",\n  \"codigoPostal\": \"23000\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 201\", () => pm.response.to.have.status(201));","const j = pm.response.json();","pm.test(\"Regresa id\", () => pm.expect(j.id).to.be.a(\"number\"));","pm.test(\"numeroExterior separado\", () => pm.expect(j.numeroExterior).to.eql(\"123\"));","pm.test(\"No expone al usuario\", () => pm.expect(j).to.not.have.property(\"usuario\"));","pm.environment.set(\"direccionId\", j.id);"]}}]},
      {"name":"Listar mis direcciones","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/direcciones","host":["{{baseUrl}}"],"path":["api","direcciones"]},"description":"Mis direcciones (tarjetas) y Checkout paso 1."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));","const j = pm.response.json();","pm.test(\"Incluye la dirección creada\", () => pm.expect(j.map(d => d.id)).to.include(Number(pm.environment.get(\"direccionId\"))));"]}}]},
      {"name":"Editar dirección","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/direcciones/{{direccionId}}","host":["{{baseUrl}}"],"path":["api","direcciones","{{direccionId}}"]},"description":"Mis direcciones, botón Editar dirección.","body":{"mode":"raw","raw":"{\n  \"destinatario\": \"Cliente QA\",\n  \"telefono\": \"612-000-0000\",\n  \"calle\": \"Avenida Editada\",\n  \"numeroExterior\": \"456\",\n  \"colonia\": \"Colonia Ficticia\",\n  \"ciudad\": \"La Paz\",\n  \"estado\": \"Baja California Sur\",\n  \"codigoPostal\": \"23000\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));","pm.test(\"Se guardó el cambio\", () => pm.expect(pm.response.json().calle).to.eql(\"Avenida Editada\"));"]}}]},
      {"name":"Error: dirección sin token","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/direcciones","host":["{{baseUrl}}"],"path":["api","direcciones"]},"description":"","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 401\", () => pm.response.to.have.status(401));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: crear dirección con datos inválidos","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/direcciones","host":["{{baseUrl}}"],"path":["api","direcciones"]},"description":"","body":{"mode":"raw","raw":"{\n  \"destinatario\": \"\",\n  \"telefono\": \"abc\",\n  \"calle\": \"Calle\",\n  \"numeroExterior\": \"\",\n  \"colonia\": \"Colonia\",\n  \"ciudad\": \"Ciudad\",\n  \"estado\": \"Estado\",\n  \"codigoPostal\": \"123\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 400\", () => pm.response.to.have.status(400));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: editar dirección de otro usuario (id 1 del mock)","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/direcciones/1","host":["{{baseUrl}}"],"path":["api","direcciones","1"]},"description":"La dirección 1 es de otro cliente del mock, no del usuario del token.","body":{"mode":"raw","raw":"{\n  \"destinatario\": \"Cliente QA\",\n  \"telefono\": \"612-000-0000\",\n  \"calle\": \"Avenida Editada\",\n  \"numeroExterior\": \"456\",\n  \"colonia\": \"Colonia Ficticia\",\n  \"ciudad\": \"La Paz\",\n  \"estado\": \"Baja California Sur\",\n  \"codigoPostal\": \"23000\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 404\", () => pm.response.to.have.status(404));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: borrar dirección de otro usuario (id 1 del mock)","request":{"method":"DELETE","header":[],"url":{"raw":"{{baseUrl}}/api/direcciones/1","host":["{{baseUrl}}"],"path":["api","direcciones","1"]},"description":""},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 404\", () => pm.response.to.have.status(404));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: dirección que no existe","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/direcciones/999999","host":["{{baseUrl}}"],"path":["api","direcciones","999999"]},"description":"","body":{"mode":"raw","raw":"{\n  \"destinatario\": \"Cliente QA\",\n  \"telefono\": \"612-000-0000\",\n  \"calle\": \"Avenida Editada\",\n  \"numeroExterior\": \"456\",\n  \"colonia\": \"Colonia Ficticia\",\n  \"ciudad\": \"La Paz\",\n  \"estado\": \"Baja California Sur\",\n  \"codigoPostal\": \"23000\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 404\", () => pm.response.to.have.status(404));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]}
    ]},
    {"name":"5. Carrito","description":"Pantalla Carrito. Requiere token.","item":[
      {"name":"Agregar pieza al carrito","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/carrito/items","host":["{{baseUrl}}"],"path":["api","carrito","items"]},"description":"Pantalla Producto, botón Agregar al carrito.","body":{"mode":"raw","raw":"{\n  \"productoId\": {{productoId}}\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 201/200\", () => pm.expect(pm.response.code).to.be.oneOf([201, 200]));"]}}]},
      {"name":"Ver carrito","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/carrito","host":["{{baseUrl}}"],"path":["api","carrito"]},"description":"Pantalla Carrito."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
      {"name":"Quitar pieza del carrito","request":{"method":"DELETE","header":[],"url":{"raw":"{{baseUrl}}/api/carrito/items/{{productoId}}","host":["{{baseUrl}}"],"path":["api","carrito","items","{{productoId}}"]},"description":"Pantalla Carrito, quitar pieza."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 204/200\", () => pm.expect(pm.response.code).to.be.oneOf([204, 200]));"]}}]},
      {"name":"Volver a agregar la pieza (para el pedido)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/carrito/items","host":["{{baseUrl}}"],"path":["api","carrito","items"]},"description":"","body":{"mode":"raw","raw":"{\n  \"productoId\": {{productoId}}\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 201/200\", () => pm.expect(pm.response.code).to.be.oneOf([201, 200]));"]}}]},
      {"name":"Error: carrito sin token","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/carrito","host":["{{baseUrl}}"],"path":["api","carrito"]},"description":"","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 401\", () => pm.response.to.have.status(401));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: agregar pieza apartada (id 2 del mock)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/carrito/items","host":["{{baseUrl}}"],"path":["api","carrito","items"]},"description":"El producto 2 está APARTADO por el pedido 1 del mock.","body":{"mode":"raw","raw":"{\n  \"productoId\": 2\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 409/400\", () => pm.expect(pm.response.code).to.be.oneOf([409, 400]));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: agregar pieza que no existe","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/carrito/items","host":["{{baseUrl}}"],"path":["api","carrito","items"]},"description":"","body":{"mode":"raw","raw":"{\n  \"productoId\": 999999\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 404\", () => pm.response.to.have.status(404));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]}
    ]},
    {"name":"6. Pedidos","description":"Pantallas Checkout, Mis pedidos y Pedido. Requiere token.","item":[
      {"name":"Crear pedido","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/pedidos","host":["{{baseUrl}}"],"path":["api","pedidos"]},"description":"Checkout, botón Confirmar pedido. Confirma el pedido y vacía el carrito.","body":{"mode":"raw","raw":"{\n  \"direccionId\": {{direccionId}},\n  \"metodoPago\": \"TRANSFERENCIA\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 201\", () => pm.response.to.have.status(201));","pm.environment.set(\"pedidoId\", pm.response.json().id);"]}}]},
      {"name":"Mis pedidos","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/pedidos","host":["{{baseUrl}}"],"path":["api","pedidos"]},"description":"Pantalla Mis pedidos."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
      {"name":"Detalle de pedido","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/pedidos/{{pedidoId}}","host":["{{baseUrl}}"],"path":["api","pedidos","{{pedidoId}}"]},"description":"Pantalla Pedido."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
      {"name":"Cancelar pedido","request":{"method":"PATCH","header":[],"url":{"raw":"{{baseUrl}}/api/pedidos/{{pedidoId}}/cancelacion","host":["{{baseUrl}}"],"path":["api","pedidos","{{pedidoId}}","cancelacion"]},"description":"Pantalla Pedido, botón Cancelar. Solo pedidos pendientes."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]}}]},
      {"name":"Error: cancelar un pedido ya cancelado","request":{"method":"PATCH","header":[],"url":{"raw":"{{baseUrl}}/api/pedidos/{{pedidoId}}/cancelacion","host":["{{baseUrl}}"],"path":["api","pedidos","{{pedidoId}}","cancelacion"]},"description":""},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 409/400\", () => pm.expect(pm.response.code).to.be.oneOf([409, 400]));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: ver pedido de otro usuario (id 1 del mock)","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/pedidos/1","host":["{{baseUrl}}"],"path":["api","pedidos","1"]},"description":""},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 404\", () => pm.response.to.have.status(404));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: crear pedido con carrito vacío","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{baseUrl}}/api/pedidos","host":["{{baseUrl}}"],"path":["api","pedidos"]},"description":"","body":{"mode":"raw","raw":"{\n  \"direccionId\": {{direccionId}},\n  \"metodoPago\": \"TRANSFERENCIA\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 400/409\", () => pm.expect(pm.response.code).to.be.oneOf([400, 409]));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]},
      {"name":"Error: pedidos sin token","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/pedidos","host":["{{baseUrl}}"],"path":["api","pedidos"]},"description":"","auth":{"type":"noauth"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 401\", () => pm.response.to.have.status(401));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]}
    ]},
    {"name":"7. Limpieza","description":"Se corre al final para dejar la base como estaba.","item":[
      {"name":"Borrar dirección de prueba","request":{"method":"DELETE","header":[],"url":{"raw":"{{baseUrl}}/api/direcciones/{{direccionId}}","host":["{{baseUrl}}"],"path":["api","direcciones","{{direccionId}}"]},"description":"Mis direcciones, quitar dirección. El pedido cancelado conserva su copia de la dirección."},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 204\", () => pm.response.to.have.status(204));"]}}]},
      {"name":"Error: borrar otra vez la misma dirección","request":{"method":"DELETE","header":[],"url":{"raw":"{{baseUrl}}/api/direcciones/{{direccionId}}","host":["{{baseUrl}}"],"path":["api","direcciones","{{direccionId}}"]},"description":""},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Status 404\", () => pm.response.to.have.status(404));","pm.test(\"Error en JSON\", () => pm.response.to.be.json);"]}}]}
    ]}
  ]
}